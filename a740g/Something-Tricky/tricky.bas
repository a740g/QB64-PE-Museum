' Something tricky - a740g (2023)
' Sorry, there are barely any comments. The variable and function names should help though
' Thanks to SpriggsySpriggs for sharing the data that is used here
' It helped me optimize a lot of my code that I use elsewhere
' And yeah, I know this is overkill. What can I say... I got carried away. XD

OPTION _EXPLICIT

$RESIZE:SMOOTH

CONST DOUBLE_EPSILON = 0.0000000000000002220446049250313#
CONST FRAME_WIDTH = 80, FRAME_HEIGHT = 25
CONST SEEK_INTERVAL = 5#
CONST APP_NAME = "Something Tricky"

TYPE VideoType
    w AS LONG
    h AS LONG
    video AS STRING
    audio AS LONG
    frameSize AS LONG
    frames AS LONG
    frame AS LONG
    refreshRate AS SINGLE
END TYPE

_TITLE APP_NAME

DIM vid AS VideoType, seekDelta AS DOUBLE, oldFrame AS LONG, curFrame AS LONG

_PRINTSTRING (FRAME_WIDTH \ 2 - 22, FRAME_HEIGHT \ 2), "Please wait while we load something tricky..."

InitializeVideo vid

PlayVideo vid

DO
    DIM k AS LONG: k = _KEYHIT
    SELECT CASE k
        CASE _KEY_ESC
            EXIT DO

        CASE _KEY_LEFT
            seekDelta = seekDelta - SEEK_INTERVAL

        CASE _KEY_RIGHT
            seekDelta = seekDelta + SEEK_INTERVAL

        CASE 0
            IF seekDelta <> 0# THEN
                SeekVideo vid, seekDelta
                seekDelta = 0#
                _KEYCLEAR
            END IF
    END SELECT

    curFrame = GetVideoCurrentFrame(vid)
    IF oldFrame <> curFrame THEN
        oldFrame = curFrame
        _TITLE APP_NAME + " [" + STR$(GetHertz) + " FPS ] [" + STR$(curFrame) + " /" + STR$(GetVideoTotalFrames(vid)) + " ]"
    END IF

    _LIMIT GetVideoRefreshRate(vid)
LOOP WHILE RenderVideoFrame(vid)

FinalizeVideo vid

SYSTEM


' Loads a binary file encoded with Bin2Data
' Usage:
'   1. Encode the binary file with Bin2Data
'   2. Include the file or it's contents
'   3. Load the file like so:
'       Restore label_generated_by_bin2data
'       Dim buffer As String
'       buffer = LoadResource   ' buffer will now hold the contents of the file
FUNCTION LoadResource$
    DIM ogSize AS _UNSIGNED LONG, resize AS _UNSIGNED LONG, isComp AS _BYTE
    READ ogSize, resize, isComp ' read the header

    DIM buffer AS STRING: buffer = SPACE$(resize) ' preallocate complete buffer

    ' Read the whole resource data
    DIM i AS _UNSIGNED LONG: DO WHILE i < resize
        DIM chunk AS STRING: READ chunk
        MID$(buffer, i + 1) = chunk
        i = i + LEN(chunk)
    LOOP

    ' Decode the data
    buffer = _BASE64DECODE$(buffer)

    ' Expand the data if needed
    IF isComp THEN buffer = _INFLATE$(buffer, ogSize)

    LoadResource = buffer
END FUNCTION


' Removes all control characters from buffer
' Note: buffer will be modified
SUB RemoveControlCharacters (buffer AS STRING)
    DIM c AS _UNSIGNED _BYTE, i AS LONG, j AS LONG

    FOR i = 1 TO LEN(buffer)
        c = ASC(buffer, i)

        IF c >= 32 THEN
            j = j + 1
            ASC(buffer, j) = c
        END IF
    NEXT i

    buffer = LEFT$(buffer, j)
END SUB


FUNCTION RemapDouble# (value AS DOUBLE, oldMin AS DOUBLE, oldMax AS DOUBLE, newMin AS DOUBLE, newMax AS DOUBLE)
    RemapDouble = (value - oldMin) * (newMax - newMin) / (oldMax - oldMin) + newMin
END FUNCTION


' Calculates and returns the hertz value when repeatedly called inside a loop
FUNCTION GetHertz~&
    STATIC AS _UNSIGNED LONG counter, finalFPS
    STATIC lastTime AS DOUBLE

    DIM currentTime AS DOUBLE: currentTime = _UPTIME

    IF currentTime >= lastTime + 1.0# THEN
        lastTime = currentTime
        finalFPS = counter
        counter = 0
    END IF

    counter = counter + 1

    GetHertz = finalFPS
END FUNCTION


SUB PlayVideo (v AS VideoType)
    IF LEN(v.video) > 0 AND _PIXELSIZE = 0 THEN
        WIDTH v.w, v.h
        _CONTROLCHR OFF
        _BLINK OFF
        _ALLOWFULLSCREEN _SQUAREPIXELS , _SMOOTH
        _SCREENMOVE _MIDDLE
        LOCATE v.h, v.w, 0
        COLOR 7, 0
        _SNDPLAY v.audio
        v.frame = 0
        v.refreshRate = v.frames / _SNDLEN(v.audio)
    END IF
END SUB


SUB SeekVideo (v AS VideoType, delta AS DOUBLE)
    IF LEN(v.video) > 0 AND _PIXELSIZE = 0 AND _SNDPLAYING(v.audio) THEN
        DIM audioLen AS DOUBLE: audioLen = _SNDLEN(v.audio)
        DIM audioCursor AS DOUBLE: audioCursor = _SNDGETPOS(v.audio)
        DIM position AS DOUBLE: position = audioCursor + delta

        IF position < 0# THEN
            position = 0#
        ELSEIF position >= audioLen THEN
            position = audioLen - DOUBLE_EPSILON
        END IF

        v.frame = RemapDouble(position, 0#, audioLen - DOUBLE_EPSILON, 0, v.frames - 1)
        _SNDSETPOS v.audio, position
    END IF
END SUB


FUNCTION RenderVideoFrame%% (v AS VideoType)
    IF LEN(v.video) > 0 AND _PIXELSIZE = 0 AND _SNDPLAYING(v.audio) AND v.frame < v.frames THEN
        DIM byteCursor AS LONG: byteCursor = 1 + v.frame * v.frameSize

        DIM y AS LONG: FOR y = 1 TO v.h
            DIM x AS LONG: FOR x = 1 TO v.w
                _PRINTSTRING (x, y), CHR$(ASC(v.video, byteCursor))
                byteCursor = byteCursor + 1
            NEXT x
        NEXT y

        v.frame = v.frame + 1

        RenderVideoFrame = _TRUE
    END IF
END FUNCTION


FUNCTION GetVideoRefreshRate! (v AS VideoType)
    GetVideoRefreshRate = v.refreshRate
END FUNCTION


FUNCTION GetVideoTotalFrames& (v AS VideoType)
    GetVideoTotalFrames = v.frames
END FUNCTION


FUNCTION GetVideoCurrentFrame& (v AS VideoType)
    GetVideoCurrentFrame = v.frame
END FUNCTION


SUB FinalizeVideo (v AS VideoType)
    IF LEN(v.video) > 0 THEN
        _SNDCLOSE v.audio
        v.video = ""
    END IF
END SUB


SUB InitializeVideo (v AS VideoType)
    IF LEN(v.video) = 0 THEN
        v.w = FRAME_WIDTH
        v.h = FRAME_HEIGHT
        v.frameSize = v.w * v.h

        RESTORE data_tricky_ogg_2074198
        v.video = LoadResource
        v.audio = _SNDOPEN(v.video, "memory, noasync")

        RESTORE data_tricky_txt_25810650
        v.video = LoadResource
        RemoveControlCharacters v.video

        v.frames = LEN(v.video) \ v.frameSize
    END IF


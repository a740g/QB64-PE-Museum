'Spaceship - settings and high scores (plain text files next to the game)

SUB LoadConfig
    DIM fh AS LONG, l AS STRING, k AS STRING, v AS STRING, p AS INTEGER, f AS STRING
    Game.Difficulty = DIFF_NORMAL
    Game.MusicVol = 8
    Game.SfxVol = 10
    Game.Fullscreen = 0
    Game.Unlocked = 1
    DefaultBindings
    f = BasePath + "spaceship.cfg"
    IF _FILEEXISTS(f) = 0 THEN EXIT SUB
    fh = FREEFILE
    OPEN f FOR INPUT AS #fh
    DO UNTIL EOF(fh)
        LINE INPUT #fh, l
        p = INSTR(l, "=")
        IF p = 0 THEN _CONTINUE
        k = LCASE$(_TRIM$(LEFT$(l, p - 1)))
        v = _TRIM$(MID$(l, p + 1))
        SELECT CASE k
            CASE "difficulty": Game.Difficulty = VAL(v)
            CASE "musicvol": Game.MusicVol = VAL(v)
            CASE "sfxvol": Game.SfxVol = VAL(v)
            CASE "fullscreen": Game.Fullscreen = VAL(v) <> 0
            CASE "unlocked": Game.Unlocked = VAL(v)
            CASE "keys1": ParseBindList v, 1
            CASE "keys2": ParseBindList v, 2
            CASE "pad": ParseBindList v, 3
        END SELECT
    LOOP
    CLOSE #fh
    IF Game.Difficulty < DIFF_EASY OR Game.Difficulty > DIFF_HARD THEN Game.Difficulty = DIFF_NORMAL
    IF Game.MusicVol < 0 OR Game.MusicVol > 10 THEN Game.MusicVol = 8
    IF Game.SfxVol < 0 OR Game.SfxVol > 10 THEN Game.SfxVol = 10
    IF Game.Unlocked < 1 THEN Game.Unlocked = 1
END SUB

SUB ParseBindList (v AS STRING, which AS INTEGER)
    DIM a AS INTEGER, st AS INTEGER, p AS INTEGER, n AS LONG
    st = 1
    FOR a = 1 TO A_COUNT
        p = INSTR(st, v, ",")
        IF p = 0 THEN p = LEN(v) + 1
        n = VAL(MID$(v, st, p - st))
        SELECT CASE which
            CASE 1: KeyBind1(a) = n
            CASE 2: KeyBind2(a) = n
            CASE 3: PadBind(a) = n
        END SELECT
        st = p + 1
        IF st > LEN(v) THEN EXIT FOR
    NEXT
END SUB

FUNCTION BindList$ (which AS INTEGER)
    DIM a AS INTEGER, s AS STRING, n AS LONG
    FOR a = 1 TO A_COUNT
        SELECT CASE which
            CASE 1: n = KeyBind1(a)
            CASE 2: n = KeyBind2(a)
            CASE 3: n = PadBind(a)
        END SELECT
        IF a > 1 THEN s = s + ","
        s = s + NumStr$(n)
    NEXT
    BindList$ = s
END FUNCTION

SUB SaveConfig
    DIM fh AS LONG
    IF Test.Active THEN EXIT SUB
    fh = FREEFILE
    OPEN BasePath + "spaceship.cfg" FOR OUTPUT AS #fh
    PRINT #fh, "difficulty=" + NumStr$(Game.Difficulty)
    PRINT #fh, "musicvol=" + NumStr$(Game.MusicVol)
    PRINT #fh, "sfxvol=" + NumStr$(Game.SfxVol)
    PRINT #fh, "fullscreen=" + NumStr$(ABS(Game.Fullscreen))
    PRINT #fh, "unlocked=" + NumStr$(Game.Unlocked)
    PRINT #fh, "keys1=" + BindList$(1)
    PRINT #fh, "keys2=" + BindList$(2)
    PRINT #fh, "pad=" + BindList$(3)
    CLOSE #fh
END SUB

SUB LoadScores
    DIM fh AS LONG, l AS STRING, i AS INTEGER, p1 AS INTEGER, p2 AS INTEGER, f AS STRING
    'Defaults
    RESTORE DefaultScores
    FOR i = 1 TO 10
        READ HighScores(i).Nm, HighScores(i).Score, HighScores(i).Chapter
    NEXT
    f = BasePath + "scores.dat"
    IF _FILEEXISTS(f) = 0 THEN EXIT SUB
    fh = FREEFILE
    OPEN f FOR INPUT AS #fh
    i = 0
    DO UNTIL EOF(fh) OR i >= 10
        LINE INPUT #fh, l
        p1 = INSTR(l, ",")
        p2 = INSTR(p1 + 1, l, ",")
        IF p1 > 0 AND p2 > p1 THEN
            i = i + 1
            HighScores(i).Nm = LEFT$(l, p1 - 1)
            HighScores(i).Score = VAL(MID$(l, p1 + 1, p2 - p1 - 1))
            HighScores(i).Chapter = VAL(MID$(l, p2 + 1))
        END IF
    LOOP
    CLOSE #fh

    DefaultScores:
    DATA FEL,50000,8,ACE,40000,7,BAS,30000,6,QBX,25000,5,JOY,20000,4
    DATA CPU,15000,4,ZAP,10000,3,SKY,7500,2,ION,5000,2,NUB,2500,1
END SUB

SUB SaveScores
    DIM fh AS LONG, i AS INTEGER
    IF Test.Active THEN EXIT SUB
    fh = FREEFILE
    OPEN BasePath + "scores.dat" FOR OUTPUT AS #fh
    FOR i = 1 TO 10
        PRINT #fh, HighScores(i).Nm + "," + NumStr$(HighScores(i).Score) + "," + NumStr$(HighScores(i).Chapter)
    NEXT
    CLOSE #fh
END SUB

FUNCTION ScoreRank% (s AS LONG)
    DIM i AS INTEGER
    ScoreRank% = 0
    IF s <= 0 THEN EXIT FUNCTION
    FOR i = 1 TO 10
        IF s > HighScores(i).Score THEN ScoreRank% = i: EXIT FUNCTION
    NEXT
END FUNCTION

SUB InsertScore (rank AS INTEGER, nm AS STRING, s AS LONG, chapter AS INTEGER)
    DIM i AS INTEGER
    IF rank < 1 OR rank > 10 THEN EXIT SUB
    FOR i = 10 TO rank + 1 STEP -1
        HighScores(i) = HighScores(i - 1)
    NEXT
    HighScores(rank).Nm = nm
    HighScores(rank).Score = s
    HighScores(rank).Chapter = chapter
    SaveScores
END SUB
